# ═══════════════════════════════════════
# Echo Voice — 配置模板
# 复制为 .env 并填写真实值
# AI 会自动通过 setup.py 写入配置
# ═══════════════════════════════════════

# ── 飞书 ──
# https://open.feishu.cn/app 创建应用获取
APP_ID=
APP_SECRET=
CHAT_ID=

# ── FFmpeg ──
FFMPEG_PATH=ffmpeg

# ── TTS ──
TTS_ENGINE=edge-tts
EDGE_TTS_VOICE=zh-CN-XiaoyiNeural

# ── 火山引擎（TTS_ENGINE=volc 时必填） ──
VOLC_API_KEY=
VOLC_RESOURCE_ID=seed-tts-2.0
VOLC_SPEAKER=
