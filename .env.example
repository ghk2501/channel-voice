# =====================================
# Channel Voice -- configuration template
# Copy to .env and fill in values
# =====================================

# -- Channel selection --
# Options: feishu / telegram / dingtalk
CHANNEL=feishu

# -- Feishu/Lark (required when CHANNEL=feishu) --
APP_ID=
APP_SECRET=
CHAT_ID=

# -- Telegram (required when CHANNEL=telegram) --
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -- DingTalk (required when CHANNEL=dingtalk) --
DINGTALK_KEY=
DINGTALK_SECRET=
DINGTALK_CHAT_ID=

# -- FFmpeg --
FFMPEG_PATH=ffmpeg

# -- TTS Engine --
TTS_ENGINE=edge-tts
EDGE_TTS_VOICE=zh-CN-XiaoyiNeural

# -- Volcengine (required when TTS_ENGINE=volc) --
VOLC_API_KEY=
VOLC_RESOURCE_ID=seed-tts-2.0
VOLC_SPEAKER=
